# Professional Samadhan - Environment Configuration Example

# APP_URL: Public URL of the applet (auto-injected in production, or http://localhost:3000 in dev)
APP_URL="http://localhost:3000"

# Cloud SQL (PostgreSQL) Runtime & Drizzle Kit Variables
# Auto-injected in AI Studio environment when Cloud SQL is provisioned
SQL_HOST="127.0.0.1"
SQL_DB_NAME="postgres"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""

# Meta WhatsApp Business Platform (Optional - Automated Mode B)
# If left empty, the application operates in Manual WhatsApp Mode A (prefilled WhatsApp links)
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WEBHOOK_VERIFY_TOKEN="professional_samadhan_token_2026"

# n8n Community Edition & Background Worker Secret
INTERNAL_WORKER_SECRET="ps_internal_worker_key_2026"

# Optional Cloud / Local AI (Disabled by default - zero cloud API costs)
ENABLE_PAID_CLOUD_OCR="false"
LOCAL_OLLAMA_HOST="http://localhost:11434"
